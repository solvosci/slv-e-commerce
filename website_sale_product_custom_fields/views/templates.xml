<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="cart_inherit_add_delivery_date" inherit_id="website_sale.cart">
        <xpath expr="//div[@class='col-lg-12']" position="inside">
            <form action="/shop/checkout" method="get" t-if="request.httprequest.path.endswith('/cart') and website_sale_order.order_line">
                <div class="mt-3 mb-3">
                    <label class="form-label">
                        Delivery Date
                    </label>
                    <input type="date"
                        name="adv_requested_delivery_date"
                        class="form-control"
                        style="max-width:250px;" />
                </div>
            </form>
        </xpath>
    </template>
</odoo>
