<odoo>

    <template id="product" name="Partner Ref and EAN" inherit_id="website_sale.product">
        <xpath expr="//t[@t-set='product_documents']" position="before">
            <t t-if="product.barcode or product.website_partner_ref">
                <div class="o_not_editable" style="font-weight: bold;">
                    <t t-if="product.barcode">
                        <span>EAN: <span t-field="product.barcode"/></span><br/>
                    </t>
                    <t t-if="product.website_partner_ref">
                        <span>SKU: <span t-field="product.website_partner_ref"/></span>
                    </t>
                </div>
            </t>
        </xpath>
    </template>

</odoo>
