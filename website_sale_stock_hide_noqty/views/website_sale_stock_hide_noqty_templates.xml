<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template
        id="product"
        inherit_id="website_sale.product"
        priority="999"
    >
        <xpath
            expr="//form/div/p[@t-if='True']"
            position="replace"
        >
            <p
                t-if="True"
                class="css_not_available_msg alert alert-warning"
            >
                This combination has no stock or does not exist.
            </p>
        </xpath>
    </template>
</odoo>
